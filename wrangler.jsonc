// yolog.dev: a static site on Cloudflare Workers (static assets only, no code).
// `node build.mjs` writes dist/; wrangler runs it before every deploy.
{
  "name": "yolog-dev",
  "compatibility_date": "2026-10-01",
  "build": { "command": "node build.mjs" },
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [
    { "pattern": "yolog.dev", "custom_domain": true },
    { "pattern": "www.yolog.dev", "custom_domain": true }
  ]
}
